# 복사해서 .env 로 사용 (.env 는 절대 커밋 금지)

# C — LLM
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-5-5
REPORT_MODEL=claude-opus-5-5

# A — 상품·가격 (네이버 쇼핑 검색 API)
# 비우면 아래 NAVER_CLIENT_ID/SECRET 을 쓴다. 쇼핑 검색용 키가 뉴스용과 다르면 채운다
NAVER_SHOP_CLIENT_ID=
NAVER_SHOP_CLIENT_SECRET=
# 비우면 네이버 개발자센터 주소(openapi.naver.com/v1/search/shop.json). API HUB 주소를 쓰려면 채운다
NAVER_SHOP_API_URL=

# B — 뉴스·SNS
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
YOUTUBE_API_KEY=

# D — 저장소·알림
DB_PATH=data/monitor.db
# 운영 DB(PostgreSQL) 주소. 비우면 SQLite(DB_PATH) 사용
DATABASE_URL=
SLACK_WEBHOOK_REPORT=
SLACK_WEBHOOK_OPS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
# 슬랙 "전체 리포트 보기" 버튼 링크(대시보드 등). 비우면 버튼 없음
REPORT_URL=
