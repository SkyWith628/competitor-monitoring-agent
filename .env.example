# 복사해서 .env 로 사용 (.env 는 절대 커밋 금지)

# C — LLM
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-5-5
REPORT_MODEL=claude-opus-5-5

# B — 뉴스·SNS
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
YOUTUBE_API_KEY=

# D — 저장소·알림
DB_PATH=data/monitor.db
# 비우면 위 SQLite 파일 사용(로컬 개발). 운영은 Supabase 연결 문자열 — app/infra/README.md 참고
DATABASE_URL=
SLACK_WEBHOOK_REPORT=
SLACK_WEBHOOK_OPS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
