# 로컬 실행용 설정. 이 파일을 복사해 .env 로 만들고 값을 채운다 (.env 는 절대 커밋 금지).
#   Windows:  copy .env.example .env        macOS/Linux:  cp .env.example .env
# 채운 뒤 `python -m app doctor` 로 빠진 값·잘못 들어간 값을 확인한다.
#
# 값은 한 줄로, 따옴표 없이, 앞뒤 공백 없이 넣는다.  예) YOUTUBE_API_KEY=AIza...
# 운영(GitHub Actions)은 이 파일이 아니라 저장소 Settings → Secrets and variables → Actions 의 값을 쓴다.
# 같은 이름으로 양쪽에 넣어야 하고, 키를 바꾸면 두 곳 모두 고친다.

# ── C — LLM (분류·주간 리포트) ─────────────────────────────────────────────
# Anthropic 콘솔(console.anthropic.com) → API Keys. sk-ant- 로 시작한다
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-5-5
REPORT_MODEL=claude-opus-5-5

# ── B — 뉴스 ────────────────────────────────────────────────────────────
# NAVER API HUB(네이버 클라우드 콘솔)에서 발급한 검색 API 키. 계정 마스터 키가 아니라 API HUB 전용 키
# 없으면 구글 뉴스만 수집되고, 네이버 쪽은 실패로 표시된다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── B — SNS ─────────────────────────────────────────────────────────────
# Google Cloud Console → YouTube Data API v3 사용 설정 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=
# Meta 개발자 앱의 장기 사용자 토큰 (약 60일마다 만료 → 다시 발급)
# 필요 권한: instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement, business_management
IG_ACCESS_TOKEN=
# 우리 팀 인스타그램 비즈니스 계정의 숫자 ID (경쟁사 계정이 아님)
IG_BUSINESS_ACCOUNT_ID=

# ── A — 상품·가격 (네이버 쇼핑 검색 API) ────────────────────────────────────
# ⚠ NAVER API HUB 는 쇼핑 검색을 제공하지 않는다 (2026-11-24 상품 안내 페이지 확인: 블로그·뉴스·백과사전·
#   카페글·지식iN·웹문서·이미지·지역만). 위의 뉴스용 API HUB 키로는 401 인증 오류가 난다.
#   네이버 개발자센터(developers.naver.com)에서 "검색" API 를 켜 둔 기존 애플리케이션의
#   Client ID / Secret 이 있을 때만 채운다. 없으면 상품 수집은 쓸 수 없다 → app/site_monitor/README.md
NAVER_SHOP_CLIENT_ID=
NAVER_SHOP_CLIENT_SECRET=
# 비우면 개발자센터 주소(openapi.naver.com/v1/search/shop.json)를 쓴다
NAVER_SHOP_API_URL=

# ── D — 저장소 ──────────────────────────────────────────────────────────
# 로컬은 비워 둔다 → 아래 DB_PATH 의 SQLite 파일을 쓴다 (운영 데이터와 섞이지 않는다)
# 운영 DB 주소(PostgreSQL)를 넣으면 로컬 실행이 운영 DB 에 그대로 기록되므로 주의
DATABASE_URL=
DB_PATH=data/monitor.db

# ── D — 알림 ────────────────────────────────────────────────────────────
# 슬랙 앱(api.slack.com/apps) → Incoming Webhooks. https://hooks.slack.com/services/... 꼴
# 로컬 테스트 때는 비워 두면 발송하지 않는다 (운영 경고는 콘솔에만 출력)
SLACK_WEBHOOK_REPORT=
SLACK_WEBHOOK_OPS=
# 메일. Gmail 이면 SMTP_USER 는 주소, SMTP_PASSWORD 는 계정 비밀번호가 아니라 앱 비밀번호(16자리)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 받는 사람. 여러 명이면 쉼표로 구분 (a@example.com,b@example.com)
MAIL_TO=
# 보낸 사람 이름 (선택). 비우면 "경쟁사 모니터링"
MAIL_FROM_NAME=
# 슬랙 "전체 리포트 보기" 버튼 링크 (선택). 웹 대시보드를 배포했으면 https://<주소>/reports/latest
REPORT_URL=
