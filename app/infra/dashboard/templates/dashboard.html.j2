{#-
  경쟁사 모니터링 대시보드 템플릿. 값은 전부 app/infra/dashboard/__init__.py 의 render()가 계산해서
  넘긴다(집계·차트 좌표·시각 형식·상태 판정). 여기서는 받은 값을 그리기만 한다.

  지켜야 할 것
  - 단일 파일: 외부 CSS·JS·폰트·이미지를 쓰지 않는다(메일 첨부·로컬 파일로 열어도 그대로 보여야 한다).
  - 긁어 온 글은 autoescape에 맡긴다. `| safe`를 쓰지 않는다. 링크는 render()가 걸러 준 e.url만 건다.
  - 색만으로 뜻을 전하지 않는다: 브랜드는 색+모양(swatch), 상태는 색+모양+글자(state).

  구성: 매크로 → <style> → 본문(운영 상태 / 브랜드별 현황 / 일별 이벤트 추이 / 주요 이벤트 /
        주간 리포트 / LLM 사용량) → <script>(차트 툴팁·키보드 이동, 인쇄 때 펼치기)
-#}
{#- 브랜드 표식. n은 1~4(Brand 선언 순서). 색각 이상이 있어도 범례·카드·툴팁에서 브랜드를 가려낼 수
    있게 계열마다 모양을 다르게 쓴다: 1 원, 2 네모, 3 세모, 4 마름모 -#}
{%- macro swatch(n) -%}
<svg class="swatch s{{ n }}" viewBox="0 0 10 10" width="11" height="11" aria-hidden="true" focusable="false">
{%- if n == 1 %}<circle cx="5" cy="5" r="5"/>
{%- elif n == 2 %}<rect width="10" height="10" rx="1"/>
{%- elif n == 3 %}<path d="M5 0 10 10H0z"/>
{%- else %}<path d="M5 0 10 5 5 10 0 5z"/>{% endif -%}
</svg>
{%- endmacro -%}
{#- 상태 표시. kind는 render()의 상태 키(ok·stale·missing / sent·partial·unsent)와 강조용 alert.
    글자 + 모양 + 색을 함께 쓴다: 꽉 찬 원 = 정상·발송, 세모 = 지연·확인 필요, 반원 = 일부 발송,
    빈 원 = 기록 없음·미발송. 글꼴마다 생김새가 다른 문자(●▲) 대신 SVG로 그린다 -#}
{%- macro state(kind, label) -%}
<span class="state state-{{ kind }}"><svg class="glyph" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true" focusable="false">
{%- if kind in ("ok", "sent") %}<circle cx="5" cy="5" r="4.5"/>
{%- elif kind in ("stale", "alert") %}<path d="M5 .5 10 9.5H0z"/>
{%- elif kind == "partial" %}<circle class="ring" cx="5" cy="5" r="4"/><path d="M5 1a4 4 0 0 0 0 8z"/>
{%- else %}<circle class="ring" cx="5" cy="5" r="4"/>{% endif -%}
</svg>{{ label }}</span>
{%- endmacro -%}
{#- 시각 하나. t는 render()의 _time_view 값({text, iso, ago}) 또는 none -#}
{%- macro when(t) -%}
{%- if t %}<time datetime="{{ t.iso }}">{{ t.text }}</time>{% else %}-{% endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>경쟁사 모니터링 대시보드 · {{ generated_date }}</title>
<style>
  /* ---- 색 토큰. 밝은 배색이 기본이고, 화면이 다크 모드일 때만 아래에서 덮어쓴다 ---- */
  :root {
    color-scheme: light;
    --page: #f9f9f7; --surface: #fcfcfb; --wash: #f0efec;
    --ink: #0b0b0b; --ink-2: #52514e; --muted: #77756f;
    --grid: #e1e0d9; --axis: #c3c2b7; --border: rgba(11, 11, 11, 0.10);
    --link: #1c5cab; --ok: #006300; --alert: #b92d2d;
    /* 브랜드 4색(파랑·주황·초록·자주). 고른 기준: ① 카드 배경과 대비 3:1 이상 ② 적록·청황 색각 이상
       시뮬레이션에서도 어느 두 색이든 구분됨. 그래서 색상만이 아니라 밝기도 서로 다르게 잡았다.
       색을 바꿀 때는 두 기준을 다시 확인할 것(다크 모드 값은 어두운 배경 기준으로 따로 고른 것) */
    --series-1: #2a78d6; --series-2: #d17236; --series-3: #2f6b12; --series-4: #a31583;
  }
  /* screen 한정: 다크 모드 PC에서 인쇄해도 흰 종이에 밝은 글자가 찍히지 않게 인쇄는 항상 밝은 배색 */
  @media screen and (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --page: #0d0d0d; --surface: #1a1a19; --wash: #2c2c2a;
      --ink: #f0efec; --ink-2: #c3c2b7; --muted: #979590;
      --grid: #2c2c2a; --axis: #383835; --border: rgba(255, 255, 255, 0.10);
      --link: #86b6ef; --ok: #0ca30c; --alert: #e66767;
      --series-1: #3987e5; --series-2: #e29936; --series-3: #35802a; --series-4: #ca358b;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--page); color: var(--ink);
    font: 15px/1.55 system-ui, -apple-system, "Segoe UI", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    /* 한글은 단어 중간에서 끊지 않되, 공백 없는 긴 주소·제목은 어디서든 끊어 화면 밖으로 넘치지 않게 */
    word-break: keep-all; overflow-wrap: anywhere;
  }
  main { max-width: 1080px; margin: 0 auto; padding: 28px 16px 48px; }
  header { margin-bottom: 24px; }
  h1 { font-size: 22px; line-height: 1.3; margin: 0 0 4px; }
  h2 { font-size: 16px; margin: 0; }
  h3 { font-size: 15px; margin: 0; }
  p { margin: 0; }
  a { color: var(--link); text-underline-offset: 2px; }
  :focus-visible { outline: 2px solid var(--link); outline-offset: 2px; border-radius: 3px; }
  time { white-space: nowrap; }
  .sub { color: var(--ink-2); font-size: 13px; }
  .num { font-variant-numeric: tabular-nums; }  /* 숫자 폭을 고정해 표의 자릿수가 세로로 맞게 */
  section { margin-top: 28px; }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin-bottom: 12px; }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .empty { color: var(--muted); font-size: 14px; padding: 20px 0; text-align: center; }
  /* ---- 브랜드 표식·상태 표시(매크로 swatch, state가 쓰는 클래스) ---- */
  .swatch { display: inline-block; flex: none; }
  .s1 { fill: var(--series-1); }
  .s2 { fill: var(--series-2); }
  .s3 { fill: var(--series-3); }
  .s4 { fill: var(--series-4); }
  .state { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .state .glyph { flex: none; fill: var(--muted); }
  .state .glyph .ring { fill: none; stroke: var(--muted); stroke-width: 1.5; }
  .state-ok .glyph, .state-sent .glyph { fill: var(--ok); }
  .state-stale, .state-alert, .state-unsent { font-weight: 600; }
  .state-stale .glyph, .state-alert .glyph { fill: var(--alert); }
  .stat-value .glyph { width: 14px; height: 14px; }

  /* ---- 운영 상태 ---- */
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px;
           margin-bottom: 12px; }
  .tile .stat-value { font-size: 22px; }
  .tile .sub { margin-top: 2px; }
  .health-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px;
                 align-items: start; }
  .health-grid .panel { min-width: 0; }  /* 표가 넓어도 격자 칸이 화면 밖으로 밀려나지 않게 */
  .health-grid h3 { margin-bottom: 8px; }
  .cell-sub { display: block; color: var(--muted); font-size: 12px; }

  /* ---- 브랜드별 현황 ---- */
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
  .card h3 { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .stat-label { color: var(--ink-2); font-size: 12px; }
  .stat-value { font-size: 26px; font-weight: 600; line-height: 1.2; }
  .breakdown { list-style: none; margin: 12px 0 0; padding: 12px 0 0; border-top: 1px solid var(--grid);
               display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 13px; color: var(--ink-2); }
  .breakdown b { color: var(--ink); font-weight: 600; }
  .breakdown-title { width: 100%; font-size: 12px; color: var(--muted); }

  /* ---- 일별 이벤트 추이 ----
     세로축 숫자(.yaxis)는 SVG 밖 HTML로 두고, SVG(.plot)는 가로를 %로 그린다. 화면 폭이 달라져도
     막대만 늘어나고 글자 크기는 그대로다. */
  .legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0 0 12px; padding: 0; list-style: none;
            font-size: 13px; color: var(--ink-2); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .legend b { color: var(--ink); font-weight: 600; }
  .chart { position: relative; display: flex; gap: 6px; }
  .yaxis { position: relative; flex: none; width: 26px; font-size: 11px; color: var(--muted); }
  .yaxis span { position: absolute; right: 0; transform: translateY(-50%); }
  .plot { flex: 1; min-width: 0; display: block; overflow: visible; }
  .plot .grid { stroke: var(--grid); stroke-width: 1; }
  .plot .base { stroke: var(--axis); stroke-width: 1; }
  .plot text { fill: var(--muted); font-size: 11px; text-anchor: middle; }
  /* .hit = 하루 한 칸을 덮는 투명한 사각형. 얇은 막대 대신 칸 전체가 포인터·포커스 대상이다.
     포커스 표시는 outline 대신 stroke로 그린다(SVG 도형의 outline은 브라우저마다 다르게 나온다) */
  .plot .hit { fill: transparent; outline: none; }
  .plot .hit:hover, .plot .hit.on { fill: var(--ink); fill-opacity: 0.06; }
  .plot .hit:focus-visible { fill: var(--ink); fill-opacity: 0.08; stroke: var(--link); stroke-width: 2; }
  .hint { margin-top: 6px; font-size: 12px; color: var(--muted); }
  .tip { position: absolute; z-index: 1; display: none; pointer-events: none; min-width: 132px;
         background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px;
         box-shadow: 0 4px 16px rgba(0, 0, 0, 0.14); font-size: 12px; color: var(--ink-2); }
  .tip-day { color: var(--ink); font-weight: 600; margin-bottom: 4px; }
  .tip-row { display: flex; align-items: center; gap: 6px; }
  .tip-row b { color: var(--ink); margin-left: auto; padding-left: 12px; }

  /* ---- 표 공통 ---- */
  details > summary { cursor: pointer; color: var(--ink-2); font-size: 13px; width: fit-content; }
  details > summary:hover { color: var(--ink); }
  .table-view { margin-top: 12px; }
  .scroll { overflow-x: auto; }  /* 표가 넘치면 페이지가 아니라 표만 가로로 스크롤 */
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 7px 10px; text-align: right; border-bottom: 1px solid var(--grid); white-space: nowrap; }
  th { font-weight: 400; }
  thead th { color: var(--ink-2); font-weight: 500; font-size: 12px; vertical-align: bottom; }
  th:first-child, td:first-child { text-align: left; padding-left: 0; white-space: normal; }
  td.left, th.left { text-align: left; }
  td.wrap { white-space: normal; }
  /* 좁은 화면: 날짜와 시각 사이에서 줄을 바꿔 첫 열(브랜드·소스)이 글자 중간에서 끊기지 않게 한다 */
  @media (max-width: 480px) {
    th, td { padding: 7px 5px; font-size: 12px; }
    .cell-sub time { white-space: normal; }
  }
  th:last-child, td:last-child { padding-right: 0; }
  tbody tr:last-child > * { border-bottom: 0; }
  tfoot th, tfoot td { font-weight: 600; border-top: 1px solid var(--axis); border-bottom: 0; }
  .table-view table { margin-top: 8px; }

  /* ---- 주요 이벤트 ---- */
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows > li { padding: 12px 0; border-bottom: 1px solid var(--grid); }
  .rows > li:first-child { padding-top: 0; }
  .rows > li:last-child { padding-bottom: 0; border-bottom: 0; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12px; color: var(--ink-2);
          margin-bottom: 4px; }
  .badge { display: inline-block; padding: 1px 8px; border-radius: 999px; background: var(--wash);
           color: var(--ink); white-space: nowrap; }
  .badge.top { background: var(--ink); color: var(--surface); font-weight: 600; }
  .meta .date { margin-left: auto; color: var(--muted); }
  .report-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; margin-bottom: 2px;
                 font-size: 12px; color: var(--ink-2); }
  .event-title { font-weight: 600; }
  .note { color: var(--ink-2); font-size: 14px; margin-top: 2px; }

  /* ---- 주간 리포트 ---- */
  .report-week { font-weight: 600; font-size: 15px; color: var(--ink); }
  .report details { margin-top: 8px; }
  .report h3 { font-size: 13px; margin: 10px 0 2px; color: var(--ink-2); font-weight: 600; }
  .report ul { margin: 0; padding-left: 18px; font-size: 14px; }

  /* ---- 사용자 환경 설정 ----
     움직임 줄이기를 켠 사용자에게는 전환 효과를 전부 끈다(지금은 차트 강조 하나뿐이지만 나중에
     효과를 더해도 빠뜨리지 않도록 전체에 건다) */
  @media (prefers-reduced-motion: no-preference) {
    .plot .hit { transition: fill-opacity 0.12s ease-out; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important; transition: none !important; scroll-behavior: auto !important;
    }
  }
  /* 고대비 모드는 색을 시스템 색으로 바꿔 막대가 전부 같은 색이 된다. 브랜드 색만 그대로 둔다 */
  @media (forced-colors: active) { .swatch, .plot rect[class^="s"] { forced-color-adjust: none; } }

  /* ---- 인쇄 ---- */
  @media print {
    body { background: #fff; font-size: 12px; }
    main { max-width: none; padding: 0; }
    section { margin-top: 18px; }
    .panel { background: #fff; break-inside: avoid; }
    .section-head, h2, h3 { break-after: avoid; }
    .rows > li, tr { break-inside: avoid; }
    .scroll { overflow: visible; }
    .tip, .hint { display: none !important; }
    /* 접힌 내용(표로 보기·인사이트)도 펼쳐서 찍는다. 종이에서는 눌러서 펼칠 수 없기 때문이다.
       ::details-content를 모르는 브라우저는 맨 아래 beforeprint 스크립트가 대신 펼친다 */
    details::details-content {
      content-visibility: visible !important; display: block !important; height: auto !important;
    }
    details > summary { list-style: none; color: var(--ink); font-weight: 600; }
    details > summary::-webkit-details-marker { display: none; }
    a { color: inherit; }
  }
</style>
</head>
<body>
<main>
  {# ================= 머리말: 제목, 생성 시각, 전체 요약 ================= #}
  <header>
    <h1>경쟁사 모니터링 대시보드</h1>
    <p class="sub">생성 시각 {{ when(generated_at) }} · 최근 {{ window_days }}일 이벤트
      <span class="num">{{ trend.total | num }}</span>건 · 수집 항목 <span class="num">{{ items_total | num }}</span>건</p>
  </header>

  {# ================= 운영 상태 =================
     "수집이 살아 있나?"를 가장 먼저 답한다. health가 none이면 안내 문구만, 있으면 요약 타일 4개 +
     표 2개. 각 값은 none(정보 없음)과 0/빈 목록(문제 없음·기록 없음)을 구분해서 보여 준다. #}
  <section aria-labelledby="h-health">
    <div class="section-head">
      <h2 id="h-health">운영 상태</h2>
      <span class="sub">생성 시각 기준 · 마지막 수집이 {{ stale_hours }}시간을 넘으면 "지연"</span>
    </div>
    {% if not health %}
    <div class="panel"><p class="empty">운영 상태 정보 없음</p></div>
    {% else %}
    {# 요약 타일: 수집 / 미분류 이벤트 / 긴급 알림 대기 / 최근 주간 리포트 #}
    <div class="tiles">
      <div class="panel tile">
        <div class="stat-label">수집</div>
        {% if health.sources is none %}
        <div class="stat-value">-</div><p class="sub">정보 없음</p>
        {% elif not health.sources %}
        <div class="stat-value">{{ state("missing", "기록 없음") }}</div><p class="sub">아직 수집된 항목이 없습니다</p>
        {% elif health.problems %}
        <div class="stat-value">{{ state("alert", "확인 필요") }}</div>
        <p class="sub">소스 <span class="num">{{ health.sources | length | num }}</span>개 중
          {%- if health.stale %} 지연 <span class="num">{{ health.stale | num }}</span>개{% endif %}
          {%- if health.stale and health.missing %} ·{% endif %}
          {%- if health.missing %} 기록 없음 <span class="num">{{ health.missing | num }}</span>개{% endif %}</p>
        {% else %}
        <div class="stat-value">{{ state("ok", "정상") }}</div>
        <p class="sub">소스 <span class="num">{{ health.sources | length | num }}</span>개 모두 {{ health.stale_hours }}시간 안에 수집</p>
        {% endif %}
      </div>
      <div class="panel tile">
        <div class="stat-label">미분류 이벤트</div>
        {% if health.unclassified is none %}
        <div class="stat-value">-</div><p class="sub">정보 없음</p>
        {% else %}
        <div class="stat-value num">{{ health.unclassified | num }}</div>
        <p class="sub">{% if health.unclassified %}다음 분류 실행을 기다리는 중{% else %}모두 분류됨{% endif %}</p>
        {% endif %}
      </div>
      <div class="panel tile">
        <div class="stat-label">긴급 알림 대기</div>
        {% if health.pending_urgent is none %}
        <div class="stat-value">-</div><p class="sub">정보 없음</p>
        {% elif health.pending_urgent %}
        <div class="stat-value">{{ state("alert", health.pending_urgent | num ~ "건") }}</div>
        <p class="sub">중요도 5인데 아직 알림이 나가지 않음</p>
        {% else %}
        <div class="stat-value num">0</div><p class="sub">밀린 긴급 알림 없음</p>
        {% endif %}
      </div>
      <div class="panel tile">
        <div class="stat-label">최근 주간 리포트</div>
        {% if health.reports is none %}
        <div class="stat-value">-</div><p class="sub">정보 없음</p>
        {% elif not health.latest_report %}
        <div class="stat-value">-</div><p class="sub">저장된 리포트 없음</p>
        {% else %}
        <div class="stat-value num">{{ health.latest_report.week }}</div>
        <p class="sub">{{ state(health.latest_report.state, health.latest_report.state_label) }}
          {%- if health.latest_report.sent %} · {{ health.latest_report.sent.ago }}{% endif %}</p>
        {% endif %}
      </div>
    </div>
    {# 상세 표. 행 제목은 <th scope="row">, 열 제목은 <th scope="col"> — 스크린리더가 칸을 읽을 때
       "스파오 spao.com, 마지막 수집, 2시간 전"처럼 행·열 제목을 함께 읽어 준다 #}
    <div class="health-grid">
      <div class="panel">
        <h3 id="h-sources">소스별 수집 상태</h3>
        {% if health.sources is none %}
        <p class="empty">수집 상태 정보 없음</p>
        {% elif not health.sources %}
        <p class="empty">아직 수집된 항목이 없습니다.</p>
        {% else %}
        <div class="scroll">
          <table aria-labelledby="h-sources">
            <thead><tr><th scope="col">브랜드 · 소스</th><th scope="col">항목</th><th scope="col" class="left">마지막 수집</th><th scope="col" class="left">상태</th></tr></thead>
            <tbody>
              {% for s in health.sources %}
              <tr>
                <th scope="row">{{ s.brand }}<span class="cell-sub">{{ s.source }}{% if s.type %} · {{ s.type }}{% endif %}</span></th>
                <td class="num">{{ s.count | num }}</td>
                <td class="left">{% if s.last %}{{ s.last.ago }}<span class="cell-sub num">{{ when(s.last) }}</span>{% else %}-{% endif %}</td>
                <td class="left">{{ state(s.state, s.state_label) }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
      </div>
      <div class="panel">
        <h3 id="h-sends">주간 리포트 발송</h3>
        {% if health.reports is none %}
        <p class="empty">발송 기록 정보 없음</p>
        {% elif not health.reports %}
        <p class="empty">아직 저장된 주간 리포트가 없습니다.</p>
        {% else %}
        <div class="scroll">
          <table aria-labelledby="h-sends">
            <thead><tr><th scope="col">주차</th><th scope="col" class="left">상태</th><th scope="col" class="left">발송 시각</th><th scope="col" class="left">채널</th></tr></thead>
            <tbody>
              {% for r in health.reports %}
              <tr>
                <th scope="row" class="num">{{ r.week }}</th>
                <td class="left">{{ state(r.state, r.state_label) }}</td>
                <td class="left">{% if r.sent %}{{ r.sent.ago }}<span class="cell-sub num">{{ when(r.sent) }}</span>{% else %}-{% endif %}</td>
                <td class="left wrap">{{ r.channels | join(", ") if r.channels else "-" }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </section>

  {# ================= 브랜드별 현황: 브랜드 카드 4장(데이터가 없어도 0으로 항상 표시) ================= #}
  <section aria-labelledby="h-brands">
    <div class="section-head">
      <h2 id="h-brands">브랜드별 현황</h2>
      <span class="sub">수집 항목은 전체 누적, 이벤트는 최근 {{ window_days }}일</span>
    </div>
    <div class="cards">
      {% for c in cards %}
      <article class="panel card">
        <h3>{{ swatch(c.series) }}{{ c.label }}</h3>
        <div class="stats">
          <div><div class="stat-label">수집 항목</div><div class="stat-value">{{ c.items_total | num }}</div></div>
          <div><div class="stat-label">이벤트</div><div class="stat-value">{{ c.events_total | num }}</div></div>
        </div>
        <ul class="breakdown">
          <li class="breakdown-title">수집 소스</li>
          {% for label, n in c.sources %}<li>{{ label }} <b class="num">{{ n | num }}</b></li>{% endfor %}
        </ul>
        <ul class="breakdown">
          <li class="breakdown-title">변화 유형</li>
          {% for label, n in c.changes %}<li>{{ label }} <b class="num">{{ n | num }}</b></li>
          {% else %}<li>감지된 변화 없음</li>{% endfor %}
        </ul>
      </article>
      {% endfor %}
    </div>
  </section>

  {# ================= 일별 이벤트 추이 =================
     누적 막대(SVG) + 같은 수치의 표("표로 보기"). 좌표는 render()의 _trend가 계산했다:
     가로는 %(col.*_x, *_w), 세로는 px(위가 0, 기준선이 trend.plot_h). #}
  <section aria-labelledby="h-trend">
    <div class="section-head">
      <h2 id="h-trend">일별 이벤트 추이</h2>
      <span class="sub">{{ trend.start }} ~ {{ trend.end }} (KST) · 브랜드별 누적</span>
    </div>
    <div class="panel">
      {% if trend.total %}
      <ul class="legend" id="trend-legend" aria-label="범례 (막대는 아래부터 이 순서로 쌓임)">
        {% for b in brands %}<li>{{ swatch(b.series) }}{{ b.label }} <b class="num">{{ b.events | num }}</b></li>{% endfor %}
      </ul>
      <div class="chart" id="trend-chart">
        <div class="yaxis" aria-hidden="true">
          {% for t in trend.ticks %}<span class="num" style="top: {{ t.y }}px">{{ t.value | num }}</span>{% endfor %}
        </div>
        <svg class="plot" width="100%" height="{{ trend.plot_h + 22 }}" role="group" aria-describedby="trend-hint"
             aria-label="최근 {{ window_days }}일 일별 이벤트 수, 브랜드별 누적 막대">
          {% for t in trend.ticks %}{% if t.value %}
          <line class="grid" x1="0" x2="100%" y1="{{ t.y }}" y2="{{ t.y }}"/>
          {% endif %}{% endfor %}
          {# 막대. 맨 위 조각만 위쪽 모서리를 둥글게: 조각 높이만큼만 보이는 안쪽 <svg> 안에 6px 더 긴
             둥근 사각형을 넣어, 아래쪽 둥근 모서리가 잘려 나가게 한다 #}
          {% for col in trend.columns %}
          {% for s in col.segments %}
          {% if s.top %}
          <svg x="{{ col.bar_x }}%" y="{{ s.y }}" width="{{ col.bar_w }}%" height="{{ s.h }}"><rect class="s{{ s.series }}" width="100%" height="{{ s.h + 6 }}" rx="3"/></svg>
          {% else %}
          <rect class="s{{ s.series }}" x="{{ col.bar_x }}%" y="{{ s.y }}" width="{{ col.bar_w }}%" height="{{ s.h }}"/>
          {% endif %}
          {% endfor %}
          {% if col.tick %}<text x="{{ col.center }}%" y="{{ trend.plot_h + 16 }}">{{ col.label }}</text>{% endif %}
          {% endfor %}
          <line class="base" x1="0" x2="100%" y1="{{ trend.plot_h }}" y2="{{ trend.plot_h }}"/>
          {# 날짜별 포인터·포커스 영역. 막대 위에 덮이도록 맨 마지막에 그린다. tabindex는 한 칸만 0
             (Tab 정지점 하나, 나머지는 화살표 키로 이동 — 아래 스크립트). aria-label이 툴팁과 같은
             내용이라 스크립트가 없어도 읽을 수 있다 #}
          {% for col in trend.columns %}
          <rect class="hit" x="{{ col.slot_x }}%" y="0" width="{{ col.slot_w }}%" height="{{ trend.plot_h }}"
                tabindex="{{ 0 if col.entry else -1 }}" role="img" aria-label="{{ col.summary }}"
                data-day="{{ col.iso }}" data-counts="{{ col.counts | join(',') }}" data-total="{{ col.total }}"/>
          {% endfor %}
        </svg>
        {# 화면에 보이는 값은 포커스된 칸의 aria-label과 같으므로 보조기기에는 숨긴다 #}
        <div class="tip" id="trend-tip" aria-hidden="true"></div>
      </div>
      <p class="hint" id="trend-hint">막대에 포인터를 올리거나, Tab으로 들어와 ← → 키로 날짜를 옮기면 그날의 수치가 보입니다.</p>
      {# 차트와 같은 수치의 표: 화면을 보지 않고도, 인쇄해서도 값을 확인할 수 있게 한다 #}
      <details class="table-view">
        <summary>표로 보기</summary>
        <div class="scroll">
          <table>
            <caption class="sub" style="text-align: left">이벤트가 있는 날만 표시 · 최신순</caption>
            <thead><tr><th scope="col">일자</th>{% for b in brands %}<th scope="col">{{ b.label }}</th>{% endfor %}<th scope="col">합계</th></tr></thead>
            <tbody>
              {% for col in trend.columns | reverse %}{% if col.total %}
              <tr><th scope="row" class="num">{{ col.iso }}</th>{% for v in col.counts %}<td class="num">{{ v | num }}</td>{% endfor %}<td class="num">{{ col.total | num }}</td></tr>
              {% endif %}{% endfor %}
            </tbody>
          </table>
        </div>
      </details>
      {% else %}
      <p class="empty">최근 {{ window_days }}일 동안 감지된 이벤트가 없습니다.</p>
      {% endif %}
    </div>
  </section>

  {# ================= 주요 이벤트: 최근 30일, 중요도 4 이상, 최신순 최대 20건 =================
     e.url은 render()가 http/https만 남긴 값이다. none이면 제목을 링크 없이 출력한다. #}
  <section aria-labelledby="h-events">
    <div class="section-head">
      <h2 id="h-events">주요 이벤트</h2>
      <span class="sub">최근 {{ window_days }}일 · 중요도 {{ high_importance }} 이상 · 최신순</span>
    </div>
    <div class="panel">
      {% if high_events %}
      <ul class="rows">
        {% for e in high_events %}
        <li>
          <div class="meta">
            <span class="badge{% if e.importance >= 5 %} top{% endif %}">중요도 {{ e.importance }}</span>
            {% if e.category %}<span class="badge">{{ e.category }}</span>{% endif %}
            <span>{{ e.brand }} · {{ e.change }}</span>
            <span class="date num">{{ when(e.time) }}</span>
          </div>
          <div class="event-title">{% if e.url %}<a href="{{ e.url }}" target="_blank" rel="noopener noreferrer">{{ e.title }}</a>{% else %}{{ e.title }}{% endif %}</div>
          {% if e.note %}<p class="note">{{ e.note }}</p>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="empty">최근 {{ window_days }}일 동안 중요도 {{ high_importance }} 이상으로 분류된 이벤트가 없습니다.</p>
      {% endif %}
    </div>
  </section>

  {# ================= 주간 리포트: 요약 한 줄 + 접어 둔 인사이트·액션 =================
     report_state는 운영 상태의 발송 기록(주차 → 상태). 없으면 주차만 보여 준다. #}
  <section aria-labelledby="h-reports">
    <div class="section-head">
      <h2 id="h-reports">주간 리포트</h2>
      <span class="sub">최신 주차 순</span>
    </div>
    <div class="panel">
      {% if reports %}
      <ul class="rows">
        {% for r in reports %}
        <li class="report">
          {% set st = report_state.get(r.week) %}
          <div class="report-head">
            <span class="report-week num">{{ r.week }}</span>
            {% if st %}<span>{{ state(st.state, st.state_label) }}{% if st.sent %} · {{ when(st.sent) }}{% endif %}
              {%- if st.channels %} · {{ st.channels | join(", ") }}{% endif %}</span>{% endif %}
          </div>
          <p>{{ r.tldr }}</p>
          {% if r.insights or r.actions %}
          <details>
            <summary>인사이트 {{ r.insights | length | num }}건 · 액션 제안 {{ r.actions | length | num }}건</summary>
            {% if r.insights %}<h3>인사이트</h3><ul>{% for i in r.insights %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
            {% if r.actions %}<h3>액션 제안</h3><ul>{% for a in r.actions %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
          </details>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="empty">아직 저장된 주간 리포트가 없습니다.</p>
      {% endif %}
    </div>
  </section>

  {# ================= LLM 사용량: 모델별 호출·토큰. 모델이 둘 이상일 때만 합계 줄 ================= #}
  <section aria-labelledby="h-usage">
    <div class="section-head">
      <h2 id="h-usage">LLM 사용량</h2>
      <span class="sub">최근 {{ window_days }}일</span>
    </div>
    <div class="panel">
      {% if usage %}
      <div class="scroll">
        <table>
          <thead><tr><th scope="col">모델</th><th scope="col">호출</th><th scope="col">입력 토큰</th><th scope="col">출력 토큰</th></tr></thead>
          <tbody>
            {% for u in usage %}
            <tr><th scope="row">{{ u.model }}</th><td class="num">{{ u.calls | num }}</td><td class="num">{{ u.input_tokens | num }}</td><td class="num">{{ u.output_tokens | num }}</td></tr>
            {% endfor %}
          </tbody>
          {% if usage | length > 1 %}
          <tfoot><tr><th scope="row">합계</th><td class="num">{{ usage_total.calls | num }}</td><td class="num">{{ usage_total.input_tokens | num }}</td><td class="num">{{ usage_total.output_tokens | num }}</td></tr></tfoot>
          {% endif %}
        </table>
      </div>
      {% else %}
      <p class="empty">최근 {{ window_days }}일 동안 기록된 LLM 호출이 없습니다.</p>
      {% endif %}
    </div>
  </section>
</main>
<script>
// 추이 차트 툴팁(포인터·키보드 공용).
// 값은 서버가 넣어 둔 data-* 속성에서 읽어 textContent로만 넣는다(innerHTML을 쓰지 않아 삽입 위험이 없다).
// 이 스크립트가 돌지 않아도 차트·범례·표는 그대로 보이고, 각 칸의 aria-label로 수치를 읽을 수 있다.
(function () {
  var chart = document.getElementById("trend-chart"), tip = document.getElementById("trend-tip");
  if (!chart || !tip) return;
  var names = {{ brands | map(attribute="label") | list | tojson }};
  // 툴팁의 브랜드 표식은 범례의 것을 복제해 쓴다(색·모양 정의를 한 곳에만 두기 위해)
  var marks = document.querySelectorAll("#trend-legend .swatch");
  var hits = Array.prototype.slice.call(chart.querySelectorAll(".hit"));
  var active = null;
  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }
  function fmt(v) { return Number(v).toLocaleString("en-US"); }
  function hide() {
    if (active) active.classList.remove("on");
    active = null;
    tip.style.display = "none";
  }
  // 툴팁 내용 채우기. 같은 칸 위에서 포인터가 움직일 때마다 다시 만들지 않도록 칸이 바뀔 때만 한다
  function fill(hit) {
    if (hit === active) return;
    if (active) active.classList.remove("on");
    active = hit;
    hit.classList.add("on");
    tip.textContent = "";
    tip.appendChild(el("div", "tip-day", hit.dataset.day + " · " + fmt(hit.dataset.total) + "건"));
    hit.dataset.counts.split(",").forEach(function (v, i) {
      var row = el("div", "tip-row");
      if (marks[i]) row.appendChild(marks[i].cloneNode(true));
      row.appendChild(el("span", "", names[i]));
      row.appendChild(el("b", "num", fmt(v)));
      tip.appendChild(row);
    });
  }
  // (x, y)는 차트 상자 기준 좌표. 오른쪽으로 넘치면 기준점 왼쪽에 놓는다.
  function place(x, y, gap) {
    tip.style.display = "block";
    var box = chart.getBoundingClientRect();
    var left = x + gap;
    if (left + tip.offsetWidth > box.width) left = x - tip.offsetWidth - gap;
    tip.style.left = Math.max(0, left) + "px";
    tip.style.top = Math.max(0, Math.min(y, box.height - tip.offsetHeight)) + "px";
  }
  function showAtPointer(hit, ev) {
    var box = chart.getBoundingClientRect();
    fill(hit);
    place(ev.clientX - box.left, ev.clientY - box.top + 14, 14);
  }
  // 키보드 포커스용: 포인터 위치가 없으므로 그 칸 옆(차트 위쪽)에 붙인다
  function showAtColumn(hit) {
    var box = chart.getBoundingClientRect(), r = hit.getBoundingClientRect();
    fill(hit);
    place(r.left + r.width / 2 - box.left, 4, r.width / 2 + 8);
  }
  chart.addEventListener("pointermove", function (ev) {
    var hit = ev.target.closest ? ev.target.closest(".hit") : null;
    if (hit) showAtPointer(hit, ev);
    else if (hits.indexOf(document.activeElement) < 0) hide();  // 키보드로 보고 있는 툴팁은 지우지 않는다
  });
  chart.addEventListener("pointerdown", function (ev) {
    var hit = ev.target.closest ? ev.target.closest(".hit") : null;
    if (hit) showAtPointer(hit, ev);
  });
  chart.addEventListener("pointerleave", function () {
    var i = hits.indexOf(document.activeElement);
    if (i < 0) hide(); else showAtColumn(hits[i]);
  });
  // 키보드: 차트에는 Tab 정지점을 하나만 두고(roving tabindex) ← → Home End로 날짜를 옮긴다.
  // 포커스를 받은 칸이 다음 Tab 정지점이 되므로, 차트를 떠났다 돌아와도 보던 날짜로 돌아온다.
  chart.addEventListener("focusin", function (ev) {
    if (hits.indexOf(ev.target) < 0) return;
    hits.forEach(function (h) { h.setAttribute("tabindex", h === ev.target ? "0" : "-1"); });
    showAtColumn(ev.target);
  });
  chart.addEventListener("focusout", hide);
  chart.addEventListener("keydown", function (ev) {
    var i = hits.indexOf(ev.target), next = null;
    if (i < 0) return;
    if (ev.key === "ArrowLeft") next = i - 1;
    else if (ev.key === "ArrowRight") next = i + 1;
    else if (ev.key === "Home") next = 0;
    else if (ev.key === "End") next = hits.length - 1;
    else if (ev.key === "Escape") { hide(); return; }
    if (next === null) return;
    ev.preventDefault();
    hits[Math.max(0, Math.min(hits.length - 1, next))].focus();
  });
})();
// 인쇄할 때 접힌 <details>를 펼쳤다가 끝나면 되돌린다(CSS ::details-content 미지원 브라우저용).
(function () {
  var opened = [];
  window.addEventListener("beforeprint", function () {
    opened = Array.prototype.slice.call(document.querySelectorAll("details:not([open])"));
    opened.forEach(function (d) { d.open = true; });
  });
  window.addEventListener("afterprint", function () {
    opened.forEach(function (d) { d.open = false; });
    opened = [];
  });
})();
</script>
</body>
</html>
